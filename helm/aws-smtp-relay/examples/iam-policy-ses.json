{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": [
        "arn:aws:ses:REGION:ACCOUNT_ID:identity/*",
        "arn:aws:ses:REGION:ACCOUNT_ID:configuration-set/*"
      ]
    }
  ]
}
